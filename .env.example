# Copy to .env and fill in. The programs do not load .env themselves;
# export these in your shell (for example: set -a; . ./.env; set +a).

# SQLite database shared by the loader, poller and MCP server.
TRANSPORT_DB_PATH=data/transport.sqlite3

# Optional: override the static NTA GTFS archive URL.
# NTA_GTFS_URL=

# NTA GTFS-Realtime (keys from https://developer.nationaltransport.ie/).
NTA_REALTIME_URL=
NTA_API_KEY=
NTA_API_KEY_HEADER=x-api-key
NTA_VEHICLE_POSITIONS_URL=
NTA_VEHICLE_API_KEY=

# MCP server.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
